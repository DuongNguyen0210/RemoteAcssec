# Local development example. Copy to infrastructure/.env and replace all secrets.
# Generate each secret independently: openssl rand -hex 32
RELAY_NODE_TOKEN=
JWT_SECRET=
POSTGRES_PASSWORD=
POSTGRES_DB=remote_db
POSTGRES_USER=admin
DATABASE_JDBC_URL=jdbc:postgresql://postgres:5432/remote_db
# For managed services, point DATABASE_JDBC_URL and REDIS_HOST / REDIS_PORT
# to private service endpoints.
REDIS_HOST=redis
REDIS_PORT=6379
MANAGEMENT_PUBLIC_PORT=80
MANAGEMENT_PUBLIC_BIND=0.0.0.0
API_UPSTREAM_1=management-api-1:9090
API_UPSTREAM_2=management-api-2:9090
API_DNS_RESOLVER=127.0.0.11
RELAY_MANAGEMENT_URL=http://nginx:9090
RELAY_1_ADVERTISED_HOST=localhost
RELAY_2_ADVERTISED_HOST=localhost
RELAY_1_PUBLIC_PORT=9091
RELAY_2_PUBLIC_PORT=9092
RELAY_CAPACITY=1000
