<RCC>
    <qresource prefix="/translations">
        <file alias="qt_vi.qm">Resources/translations/qt_vi.qm</file>
    </qresource>
    <qresource prefix="/styles">
        <file>Resources/styles/main.qss</file>
        <file>Resources/styles/sidebar.qss</file>
        <file>Resources/styles/topbar.qss</file>
        <file>Resources/styles/devicecard.qss</file>
        <file>Resources/styles/loginwindow.qss</file>
        <file>Resources/styles/registerwindow.qss</file>
    </qresource>
    <qresource prefix="/icons">
        <file>Resources/icons/account-user.svg</file>
        <file>Resources/icons/account-clock.svg</file>
        <file>Resources/icons/account-eye.svg</file>
        <file>Resources/icons/account-edit.svg</file>
        <file>Resources/icons/account-delete.svg</file>

        <file>Resources/icons/bell.svg</file>
        <file>Resources/icons/circle-question-mark.svg</file>
        <file>Resources/icons/circle-user.svg</file>
        <file>Resources/icons/computer.svg</file>
        <file>Resources/icons/devices.svg</file>
        <file>Resources/icons/logs.svg</file>
        <file>Resources/icons/sessions.svg</file>
        <file>Resources/icons/settings.svg</file>
        <file>Resources/icons/x.svg</file>
        <file>Resources/icons/add-fill.svg</file>
        <file>Resources/icons/alert-circle.svg</file>
        <file>Resources/icons/alert-triangle.svg</file>
        <file>Resources/icons/check-circle.svg</file>
        <file>Resources/icons/help-circle.svg</file>
    </qresource>
</RCC>
