/* ─── Page containers (unique per page, keep #id) ───────────────────────── */
#mainWindow,
#appRoot,
#contentShell,
#contentStack {
    background-color: #f7f9fb;
}

#devicesPage {
    background-color: #f7f9fb;
}

#sessionsPage,
#logsPage,
#settingsPage,
#accountPage {
    background-color: #f7f9fb;
}

/* ─── Page header labels ─────────────────────────────────────────────────── */
QLabel[role="pageTitle"] {
    font-size: 32px;
    font-weight: 700;
    color: #191c1e;
}

QLabel[role="pageSubtitle"] {
    color: #404850;
    font-size: 14px;
    font-weight: 400;
}

QLabel[role="pagePlaceholder"] {
    color: #404850;
    font-size: 14px;
    font-weight: 600;
    background-color: transparent;
}

/* ─── Scroll areas ───────────────────────────────────────────────────────── */
#deviceScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea[role="scrollArea"] {
    border: none;
    background-color: transparent;
}

#deviceScrollArea > QWidget > QWidget,
#deviceScrollContent,
QScrollArea[role="scrollArea"] > QWidget > QWidget,
QWidget[role="scrollContent"] {
    background-color: transparent;
}

#deviceScrollArea QScrollBar:vertical,
QScrollArea[role="scrollArea"] QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 0px;
}

#deviceScrollArea QScrollBar::handle:vertical,
QScrollArea[role="scrollArea"] QScrollBar::handle:vertical {
    background-color: #bfc7d1;
    border-radius: 5px;
    min-height: 24px;
}

#deviceScrollArea QScrollBar::handle:vertical:hover,
QScrollArea[role="scrollArea"] QScrollBar::handle:vertical:hover {
    background-color: #707881;
}

#deviceScrollArea QScrollBar::add-line:vertical,
#deviceScrollArea QScrollBar::sub-line:vertical,
QScrollArea[role="scrollArea"] QScrollBar::add-line:vertical,
QScrollArea[role="scrollArea"] QScrollBar::sub-line:vertical {
    height: 0px;
    background-color: transparent;
}

#deviceScrollArea QScrollBar::add-page:vertical,
#deviceScrollArea QScrollBar::sub-page:vertical,
QScrollArea[role="scrollArea"] QScrollBar::add-page:vertical,
QScrollArea[role="scrollArea"] QScrollBar::sub-page:vertical {
    background-color: transparent;
}

/* ─── Cards ──────────────────────────────────────────────────────────────── */
QFrame[role="metricCard"],
QFrame[role="sessionCard"],
QFrame[role="toolbarCard"],
QFrame[role="logRow"],
QFrame[role="settingsCard"] {
    background-color: #ffffff;
    border: 1px solid #dfe4ea;
    border-radius: 12px;
}

QFrame[role="metricCard"]:hover,
QFrame[role="sessionCard"]:hover,
QFrame[role="logRow"]:hover,
QFrame[role="settingsCard"]:hover {
    border: 1px solid #bfc7d1;
    background-color: #ffffff;
}

/* ─── Metric card labels ─────────────────────────────────────────────────── */
QLabel[role="metricValue"] {
    color: #005d90;
    font-size: 28px;
    font-weight: 700;
}

QLabel[role="metricTitle"],
QLabel[role="sectionTitle"] {
    color: #191c1e;
    font-size: 16px;
    font-weight: 700;
}

QLabel[role="metricDetail"],
QLabel[role="sectionSubtitle"],
QLabel[role="cardSubtitle"] {
    color: #404850;
    font-size: 13px;
    font-weight: 400;
}

/* ─── Card content labels ────────────────────────────────────────────────── */
QLabel[role="cardIcon"] {
    background-color: #eceef0;
    border-radius: 8px;
    color: #005d90;
    font-size: 12px;
    font-weight: 700;
}

QLabel[role="cardTitle"] {
    color: #191c1e;
    font-size: 15px;
    font-weight: 700;
}

QLabel[role="metaLabel"],
QLabel[role="fieldLabel"] {
    color: #707881;
    font-size: 12px;
    font-weight: 700;
}

QLabel[role="strongText"] {
    color: #191c1e;
    font-size: 14px;
    font-weight: 600;
}

/* ─── Thin divider ───────────────────────────────────────────────────────── */
QFrame[role="thinDivider"] {
    background-color: #dfe4ea;
    border: none;
    max-height: 1px;
    min-height: 1px;
}

/* ─── State chip ─────────────────────────────────────────────────────────── */
QLabel[role="stateChip"] {
    border-radius: 10px;
    font-size: 12px;
    font-weight: 700;
    padding: 4px 10px;
    min-width: 72px;
}

QLabel[role="stateChip"][state="active"] {
    background-color: #e8f3fb;
    color: #005d90;
}

QLabel[role="stateChip"][state="warning"] {
    background-color: #fff3cd;
    color: #6f5200;
}

QLabel[role="stateChip"][state="error"] {
    background-color: #ffdad6;
    color: #93000a;
}

QLabel[role="stateChip"][state="neutral"] {
    background-color: #e0e3e5;
    color: #404850;
}

/* ─── Action buttons & inputs ────────────────────────────────────────────── */
QPushButton[role="secondaryActionButton"],
QPushButton[role="filterButton"],
QLineEdit[role="panelSearchInput"],
*[role="settingsInput"] {
    background-color: #ffffff;
    border: 1px solid #bfc7d1;
    border-radius: 8px;
    color: #191c1e;
    font-size: 14px;
    padding: 0px 12px;
}

QPushButton[role="secondaryActionButton"]:hover,
QPushButton[role="filterButton"]:hover,
QLineEdit[role="panelSearchInput"]:hover,
*[role="settingsInput"]:hover {
    background-color: #eceef0;
    border-color: #707881;
}

QPushButton[role="filterButton"]:checked {
    background-color: #e8f3fb;
    border-color: #005d90;
    color: #005d90;
    font-weight: 700;
}

QPushButton[role="primaryActionButton"] {
    background-color: #005d90;
    border: none;
    border-radius: 8px;
    color: #ffffff;
    font-size: 14px;
    font-weight: 700;
    padding: 0px 14px;
}

QPushButton[role="primaryActionButton"]:hover {
    background-color: #004b74;
}

QPushButton[role="secondaryActionButton"] {
    font-weight: 700;
}

QPushButton[role="dangerActionButton"] {
    background-color: #ffffff;
    border: 1px solid #e8aaa4;
    border-radius: 8px;
    color: #ba1a1a;
    font-size: 14px;
    font-weight: 700;
    padding: 0px 12px;
}

QPushButton[role="dangerActionButton"]:hover {
    background-color: #ffdad6;
    border-color: #ba1a1a;
}

/* ─── Log labels ─────────────────────────────────────────────────────────── */
QLabel[role="logTime"] {
    color: #707881;
    font-size: 13px;
    font-weight: 600;
}

/* ─── Settings checkbox ──────────────────────────────────────────────────── */
QCheckBox[role="settingsCheckBox"] {
    color: #191c1e;
    font-size: 14px;
    spacing: 8px;
}

QPushButton[role="linkButton"] {
    background: transparent;
    color: #005d90;
    border: none;
    text-decoration: underline;
    font-size: 13px;
    font-weight: 600;
}

QPushButton[role="linkButton"]:hover {
    color: #004b74;
}

#emptyStateWidget {
    background: transparent;
}

#emptyStateIcon {
    font-size: 40px;
}

#emptyStateTitle {
    font-size: 16px;
    font-weight: 700;
    color: #191c1e;
}

#emptyStateDesc {
    font-size: 13px;
    color: #707881;
}

QPushButton#emptyStateActionBtn {
    background-color: #005d90;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    padding: 0px 16px;
}

QPushButton#emptyStateActionBtn:hover {
    background-color: #004b74;
}

/* ─── Confirm & Alert Dialog ─────────────────────────────────────────────── */
#confirmDialogCard {
    background-color: #ffffff;
    border: 1px solid #dfe4ea;
    border-radius: 16px;
}

#confirmBadge {
    border-radius: 27px;
    background-color: #e8f3fb;
}

#confirmBadge[badgeType="danger"] {
    background-color: #ffdad6;
}

#confirmBadge[badgeType="warning"] {
    background-color: #fff3cd;
}

#confirmBadge[badgeType="info"],
#confirmBadge[badgeType="question"] {
    background-color: #e8f3fb;
}

#confirmTitle {
    font-size: 18px;
    font-weight: 700;
    color: #191c1e;
    background-color: transparent;
}

#confirmMessage {
    font-size: 14px;
    font-weight: 400;
    color: #404850;
    line-height: 1.4;
    background-color: transparent;
}

QPushButton#confirmBtnCancel {
    background-color: #ffffff;
    border: 1px solid #bfc7d1;
    border-radius: 8px;
    color: #191c1e;
    font-size: 14px;
    font-weight: 600;
    padding: 0px 16px;
    min-width: 90px;
}

QPushButton#confirmBtnCancel:hover {
    background-color: #eceef0;
    border-color: #707881;
}

QPushButton#confirmBtnAction {
    border: none;
    border-radius: 8px;
    color: #ffffff;
    font-size: 14px;
    font-weight: 700;
    padding: 0px 18px;
    min-width: 90px;
}

QPushButton#confirmBtnAction[actionRole="danger"] {
    background-color: #ba1a1a;
}

QPushButton#confirmBtnAction[actionRole="danger"]:hover {
    background-color: #93000a;
}

QPushButton#confirmBtnAction[actionRole="warning"] {
    background-color: #b38600;
}

QPushButton#confirmBtnAction[actionRole="warning"]:hover {
    background-color: #8c6800;
}

QPushButton#confirmBtnAction[actionRole="primary"] {
    background-color: #005d90;
}

QPushButton#confirmBtnAction[actionRole="primary"]:hover {
    background-color: #004b74;
}

