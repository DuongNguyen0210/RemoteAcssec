# Copy to infrastructure/.env on the VPS. Do not commit the populated file.
# Generate three independent values with: openssl rand -hex 32
RELAY_NODE_TOKEN=
JWT_SECRET=
POSTGRES_PASSWORD=
POSTGRES_DB=remote_db
POSTGRES_USER=admin
DATABASE_JDBC_URL=jdbc:postgresql://postgres:5432/remote_db

# Address clients can reach. Use a public DNS name or VPS IP for each relay.
RELAY_1_ADVERTISED_HOST=relay.example.com
RELAY_2_ADVERTISED_HOST=relay.example.com
RELAY_1_PUBLIC_PORT=9091
RELAY_2_PUBLIC_PORT=9092
RELAY_CAPACITY=1000

# Local Compose routing. Override upstreams and DNS resolver if Nginx runs
# separately from the API containers on a cloud network.
API_UPSTREAM_1=management-api-1:9090
API_UPSTREAM_2=management-api-2:9090
API_DNS_RESOLVER=127.0.0.11
RELAY_MANAGEMENT_URL=http://nginx:9090

# Bind to loopback when a host TLS proxy or cloud ingress terminates HTTPS.
MANAGEMENT_PUBLIC_BIND=127.0.0.1
MANAGEMENT_PUBLIC_PORT=8080

# Optional managed PostgreSQL/Redis endpoints on a private network.
# Set DATABASE_JDBC_URL above to jdbc:postgresql://db.internal:5432/remote_db?sslmode=require
# REDIS_HOST=redis.internal
# REDIS_PORT=6379

# Required when loading docker-compose.tls.yml for public relay TLS.
# Absolute paths on the VPS; private keys must be readable by container UID 10001.
# RELAY_1_TLS_CERT=/opt/remoteaccess/tls/relay-fullchain.pem
# RELAY_1_TLS_KEY=/opt/remoteaccess/tls/relay-key.pem
# RELAY_2_TLS_CERT=/opt/remoteaccess/tls/relay-fullchain.pem
# RELAY_2_TLS_KEY=/opt/remoteaccess/tls/relay-key.pem
