# Copy to .env and generate a shared service token (e.g. openssl rand -hex 32).
RELAY_NODE_TOKEN=replace-with-a-random-service-token
POSTGRES_PASSWORD=local-development-password
RELAY_ADVERTISED_HOST=localhost
MANAGEMENT_PUBLIC_PORT=80
RELAY_CAPACITY=1000

# Required: generate 32 random bytes, encode as Base64, and keep private.
JWT_SIGNING_KEY=
